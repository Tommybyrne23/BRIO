# brioweb API base URL the app talks to.
# Local dev (device/simulator on the same LAN as your machine running `npm run dev`
# in brioweb): use your machine's LAN IP, not "localhost" (the device is a
# separate network peer and can't resolve your machine's localhost).
# Deployed: point at the deployed brioweb URL instead.
EXPO_PUBLIC_API_URL=http://192.168.1.100:3000
