# Local Postgres (docker-compose.yml) — copy this file to .env.local and adjust if needed.
DATABASE_URL=postgresql://brioweb:brioweb@localhost:5432/brioweb

# Generate with `npx auth secret`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

## Agents (chat route + autonomous insight worker)
OPENAI_API_KEY=
# Optional, defaults to gpt-5-mini if unset.
OPENAI_AGENTS_MODEL=
# Worker run interval, in minutes. Optional, defaults to 1440 (daily).
WORKER_INTERVAL_MINUTES=1440
