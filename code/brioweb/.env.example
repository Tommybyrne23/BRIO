# Local Postgres (docker-compose.yml) — copy this file to .env.local and adjust if needed.
DATABASE_URL=postgresql://brioweb:brioweb@localhost:5432/brioweb

# Generate with `npx auth secret`
BETTER_AUTH_SECRET=
# Local: http://localhost:3000. Deployment: the exact public HTTPS origin with no path.
# A mismatch causes Better Auth to reject browser writes with `Invalid origin`.
BETTER_AUTH_URL=http://localhost:3000
# Optional hostname only for a remote HTTPS development preview. Do not set in production.
# NEXT_DEV_ALLOWED_ORIGIN=3000-your-preview-host.example.com

## Agents (chat route + autonomous insight worker)
OPENAI_API_KEY=
# Optional, defaults to gpt-5-mini if unset.
OPENAI_AGENTS_MODEL=
# Optional for an OpenAI-compatible proxy. When set, BRIO uses the Agents SDK
# Chat Completions transport because some proxies do not stream Responses events.
# Leave unset when using the official OpenAI API.
OPENAI_BASE_URL=
# Worker run interval, in minutes. Optional, defaults to 1440 (daily).
WORKER_INTERVAL_MINUTES=1440

# Optional guarded synthetic demonstration reset. Keep false for ordinary accounts.
BRIO_DEMO_MODE=false
BRIO_DEMO_ACCOUNT_EMAIL=
